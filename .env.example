# Copy to .env on the machine that will run FIX-Trader (Stellar).
# Keep real credentials only in .env. Never commit or send this template with secrets.
# The Exchanges page shows the environment-variable names required for each venue.
# Stellar's Logon carries no password of its own: leave these blank for a
# session Stellar authorises by its address; set them only if Stellar issued
# a password (sent as Username 553 / Password 554).
STELLAR_UAT_PASSWORD=
STELLAR_UAT_MD_PASSWORD=
